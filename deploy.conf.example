############################################
# Deploy Configuration
# Copy this file to deploy.conf and edit
# deploy.conf is gitignored - safe for secrets
############################################

# Application
APP_USER="deploy"
APP_GROUP="www-data"
DOMAIN="your-domain.com"
WWW_DOMAIN="www.your-domain.com"

# Database
DB_CONNECTION="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="address_validation"
DB_USERNAME="address_validation"
DB_PASSWORD="YourStrongPasswordHere"

# Queue
QUEUE_CONNECTION="database"

# Shipping database (SQL Server) driver
# Installs the Microsoft ODBC driver + PHP pdo_sqlsrv extension needed for the optional
# shipping-database integration (FedEx original-address back-fill). Idempotent; set to
# "false" to skip. Configure the actual connection in the app: Settings > Shipping Database.
INSTALL_MSSQL_DRIVER="true"

# Paths (usually don't need to change)
# APP_DIR="/var/www/address-validation"
# PHP_BIN="/usr/bin/php"
# COMPOSER_BIN="/usr/local/bin/composer"
