              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has Records\", function () {",
                  "    pm.expect(jsonData).to.have.property('Records');",
                  "});",
                  "",
                  "// Log batch results",
                  "if (jsonData.Records && jsonData.Records.length > 0) {",
                  "    console.log(\"=== Batch Validation Results ===\");",
                  "    console.log(\"Total Records: \" + jsonData.Records.length);",
                  "    console.log(\"\");",
                  "    ",
                  "    jsonData.Records.forEach(function(record, idx) {",
                  "        console.log(\"--- Record \" + (record.RecordID || idx + 1) + \" ---\");",
                  "        console.log(\"Results: \" + (record.Results || 'N/A'));",
                  "        console.log(\"Address: \" + (record.FormattedAddress || record.AddressLine1 || 'N/A'));",
                  "        console.log(\"Type: \" + (record.AddressType || 'N/A'));",
                  "        console.log(\"\");",
                  "    });",
                  "} else {",
                  "    console.log(\"No records returned\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
