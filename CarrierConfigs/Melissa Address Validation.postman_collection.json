{
  "info": {
    "_postman_id": "melissa-address-validation-001",
    "name": "Melissa Address Validation",
    "description": "Melissa Data Address Validation APIs for CASS-certified validation with RDI flag and street-level candidate lookup.\n\nIncludes:\n- Global Address API - CASS validation with Residential Delivery Indicator (RDI)\n- Street Search API - Street-level house number candidate lookup\n\nDocumentation: https://docs.melissa.com/cloud-api/global-address/global-address-index.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "8255341"
  },
  "item": [
    {
      "name": "Global Address",
      "item": [
        {
          "name": "Validate Address (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has Records\", function () {",
                  "    pm.expect(jsonData).to.have.property('Records');",
                  "});",
                  "",
                  "// Log validation results",
                  "if (jsonData.Records && jsonData.Records.length > 0) {",
                  "    var record = jsonData.Records[0];",
                  "    console.log(\"=== Address Validation Result ===\");",
                  "    console.log(\"Results Codes: \" + (record.Results || 'N/A'));",
                  "    console.log(\"Formatted Address: \" + (record.FormattedAddress || 'N/A'));",
                  "    console.log(\"Address Line 1: \" + (record.AddressLine1 || 'N/A'));",
                  "    console.log(\"Locality: \" + (record.Locality || 'N/A'));",
                  "    console.log(\"Administrative Area: \" + (record.AdministrativeArea || 'N/A'));",
                  "    console.log(\"Postal Code: \" + (record.PostalCode || 'N/A'));",
                  "    console.log(\"\\n=== Delivery Classification ===\");",
                  "    console.log(\"Address Type: \" + (record.AddressType || 'N/A'));",
                  "    console.log(\"Address Type Code: \" + (record.AddressTypeCode || 'N/A'));",
                  "    console.log(\"\\n=== Key Codes ===\");",
                  "    console.log(\"Melissa Address Key (MAK): \" + (record.MelissaAddressKey || 'N/A'));",
                  "    console.log(\"Melissa Address Key Base: \" + (record.MelissaAddressKeyBase || 'N/A'));",
                  "    ",
                  "    // Parse result codes for RDI and validity",
                  "    var results = record.Results || '';",
                  "    if (results.includes('AV11') || results.includes('AV12')) {",
                  "        console.log(\"\\n✓ Address is CASS Verified\");",
                  "    }",
                  "    if (results.includes('AV14')) {",
                  "        console.log(\"⚠ Address corrected\");",
                  "    }",
                  "    if (results.includes('AE')) {",
                  "        console.log(\"✗ Address has errors: \" + results);",
                  "    }",
                  "} else {",
                  "    console.log(\"No records returned\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
