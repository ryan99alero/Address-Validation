    {
      "name": "Street Search (Lookups)",
      "item": [
        {
          "name": "Street Search - With Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has Results\", function () {",
                  "    pm.expect(jsonData).to.have.property('Results');",
                  "});",
                  "",
                  "// Log street search results",
                  "console.log(\"=== Street Search Results ===\");",
                  "console.log(\"Transmission Reference: \" + (jsonData.TransmissionReference || 'N/A'));",
                  "console.log(\"Total Found: \" + (jsonData.TotalRecords || '0'));",
                  "",
                  "if (jsonData.Results && jsonData.Results.length > 0) {",
                  "    console.log(\"\\n--- Address Candidates ---\");",
                  "    jsonData.Results.forEach(function(result, idx) {",
                  "        console.log((idx + 1) + \". \" + (result.AddressLine || 'N/A'));",
                  "        console.log(\"   City: \" + (result.City || 'N/A'));",
                  "        console.log(\"   State: \" + (result.State || 'N/A'));",
                  "        console.log(\"   ZIP: \" + (result.Zip || 'N/A'));",
                  "        console.log(\"   Range: \" + (result.AddressRange || 'N/A'));",
                  "        console.log(\"\");",
                  "    });",
                  "} else {",
                  "    console.log(\"No street candidates found\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{melissa_street_search_url}}?id={{melissa_api_key}}&t=Street Lookup&opt=&a=Parkridge Blvd&city=Irving&state=TX&zip=75063&ctry=US",
              "host": [
                "{{melissa_street_search_url}}"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{melissa_api_key}}",
                  "description": "Melissa License Key"
                },
                {
                  "key": "t",
                  "value": "Street Lookup",
                  "description": "Transmission Reference"
                },
                {
                  "key": "opt",
                  "value": "",
                  "description": "Options (RangeOnly - returns only range info)"
                },
                {
                  "key": "a",
                  "value": "Parkridge Blvd",
                  "description": "Street address (can be partial)"
                },
                {
                  "key": "city",
                  "value": "Irving",
                  "description": "City name"
                },
                {
                  "key": "state",
                  "value": "TX",
                  "description": "State abbreviation"
                },
                {
                  "key": "zip",
                  "value": "75063",
                  "description": "ZIP code"
                },
                {
                  "key": "ctry",
                  "value": "US",
                  "description": "Country code"
                }
              ]
            },
            "description": "Street Search with address for finding valid house number ranges.\n\nUseful for:\n- Finding valid street segments in a city/ZIP\n- Getting house number ranges for a street\n- Validating if a house number exists on a street\n\nUse case: When primary carrier returns invalid, search for the street to find valid house numbers, then use Levenshtein to suggest corrections."
          },
          "response": []
        },
        {
          "name": "Street Search - Range Only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Log range results",
                  "console.log(\"=== Street Range Results ===\");",
                  "",
                  "if (jsonData.Results && jsonData.Results.length > 0) {",
                  "    jsonData.Results.forEach(function(result, idx) {",
                  "        console.log((idx + 1) + \". \" + (result.AddressLine || result.Street || 'N/A'));",
                  "        if (result.AddressRange) {",
                  "            console.log(\"   Valid Range: \" + result.AddressRange);",
                  "        }",
                  "        if (result.OddRange) {",
                  "            console.log(\"   Odd Numbers: \" + result.OddRange);",
                  "        }",
                  "        if (result.EvenRange) {",
                  "            console.log(\"   Even Numbers: \" + result.EvenRange);",
                  "        }",
                  "    });",
                  "} else {",
                  "    console.log(\"No street ranges found\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
